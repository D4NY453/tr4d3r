# Copia este archivo a .env y rellena SOLO lo que uses. .env nunca se sube a git.

# Clave de Ditto Network (empieza por ditto_sk_). Si está, se usa Ditto.
DITTO_API_KEY=
# Alternativa: clave privada de AGENTE de Hyperliquid (no la de tu wallet principal).
PRIVATE_KEY=
# Dirección de la wallet principal de Hyperliquid (solo lectura de posiciones/balance).
WALLET_ADDRESS=

# Servidor: por defecto solo escucha en tu PC.
HOST=127.0.0.1
PORT=3001
# Si lo defines, todas las rutas /api exigen la cabecera  Authorization: Bearer <token>
BOT_API_TOKEN=

# EXPERIMENTAL: enviar órdenes limit a Ditto (API no documentada públicamente). Dejar en false.
DITTO_LIMIT_ORDERS=false

# Opcional: carpeta donde guardar bot-config.json, bot-state.json, bot-risk-state.json y la base SQLite
BOT_DATA_DIR=
